{
  "model": "opus",
  "cleanupPeriodDays": 30,
  "ratio": 1.0e3,
  "statusLine": {
    "type": "command",
    "command": "echo \"café ✓\" \\ tab\there"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "my-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo other-stop"
          }
        ]
      }
    ]
  },
  "env": {
    "EMOJI": "😀",
    "EMPTY": {},
    "LIST": []
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ]
  }
}
